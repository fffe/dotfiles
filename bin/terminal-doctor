#!/usr/bin/env python3
import locale
import os
import select
import subprocess
import sys

if os.name != "posix" or not sys.stdin.isatty() or not sys.stdout.isatty():
    sys.exit("Requires an interactive Unix terminal.")

import termios
import tty

sys.stdout.reconfigure(encoding="utf-8", errors="backslashreplace")
print(" ".join(f"{key}={os.environ.get(key, '')!r}" for key in
               ("TERM", "COLORTERM", "LANG", "LC_CTYPE", "LC_ALL")))
print(f"Encoding: {locale.getpreferredencoding(False)}")
try:
    import curses
    curses.setupterm()
    print(f"Terminfo colors: {curses.tigetnum('colors')}")
except Exception as error:
    print(f"Terminfo unavailable: {str(error)!r}")

if os.environ.get("TMUX"):
    try:
        result = subprocess.run(
            ["tmux", "display-message", "-p", "-t", os.environ.get("TMUX_PANE", ""),
             "#{version} client=#{client_termname} features=#{client_termfeatures} "
             "extkeys=#{extended-keys} format=#{extended-keys-format} "
             "palette=#{@shell-palette} nerd-font=#{@nerd-font}"],
            capture_output=True, text=True, timeout=2, check=True)
        print(f"tmux: {result.stdout.strip()!r}")
    except (OSError, subprocess.SubprocessError) as error:
        print(f"tmux query failed: {str(error)!r}")

print("\nUTF-8: café Ελληνικά 日本語 ┌─┐  →  ✓")
print("Icons: branch 󰘬  bell   activity   moon   zoom   caps ")
print("\n16 colors: " + "".join(f"\x1b[{color}m  " for color in
                                 (*range(40, 48), *range(100, 108))) + "\x1b[0m")
print("256 gray:  " + "".join(f"\x1b[48;5;{color}m  " for color in range(232, 256)) + "\x1b[0m")
print("RGB ramp:  " + "".join(f"\x1b[48;2;{255 - step * 5};{step * 5};160m "
                            for step in range(48)) + "\x1b[0m")

print("\n\x1b[1mbold\x1b[0m  \x1b[3mitalic\x1b[0m  \x1b[4munderline\x1b[0m  "
      "\x1b[9mstrike\x1b[0m  \x1b[4:3mcurly underline\x1b[0m  "
      "\x1b]8;;https://example.com\x1b\\hyperlink\x1b]8;;\x1b\\")
print("\nKeys / paste / focus (q to quit):")

fd = sys.stdin.fileno()
saved = termios.tcgetattr(fd)
pasting = False
tail = b""
try:
    tty.setcbreak(fd)
    print("\x1b[?2004h\x1b[?1004h\x1b[>4;2m\x1b[>1u", end="", flush=True)
    while True:
        data = os.read(fd, 4096)
        if not data or (data == b"q" and not pasting):
            break
        while len(data) < 4096 and select.select([fd], [], [], 0.02)[0]:
            chunk = os.read(fd, 4096 - len(data))
            if not chunk:
                break
            data += chunk
        markers = tail + data
        start, end = markers.rfind(b"\x1b[200~"), markers.rfind(b"\x1b[201~")
        if max(start, end) >= 0:
            pasting = start > end
        tail = markers[-5:]
        print(repr(data[:120]) + ("..." if len(data) > 120 else ""), flush=True)
except KeyboardInterrupt:
    pass
finally:
    termios.tcsetattr(fd, termios.TCSADRAIN, saved)
    print("\x1b[<u\x1b[>4;0m\x1b[?1004l\x1b[?2004l\x1b[0m", end="", flush=True)
