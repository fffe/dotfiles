emulate -L zsh
local search=rg

if (( ! $+commands[rg] )); then
  if (( $+commands[ripgrep] )); then
    search=ripgrep
  else
    print -u2 'rgl: ripgrep is not installed'
    return 127
  fi
fi

if [[ ! -t 1 ]]; then
  command "$search" "$@"
  return $?
fi

local -a pager=( "${(@Q)${(z)${PAGER:-less -R}}}" )
command "$search" --color=always --line-number "$@" | command "${pager[@]}"
local -a results=( "${pipestatus[@]}" )
(( results[2] == 0 )) || return $results[2]
(( results[1] == 141 )) && return 0
return $results[1]
